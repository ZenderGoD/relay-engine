#!/usr/bin/env node
import fs from 'node:fs';
import path from 'node:path';
import { renderDashboard } from '../lib/dashboard.mjs';

try {
  if (process.argv.length > 3) throw new Error('Usage: dashboard [state-directory]');
  const dir = path.resolve(process.argv[2] || '.relay');
  fs.writeFileSync(path.join(dir, 'dashboard.html'), renderDashboard(dir));
  console.log('Updated dashboard.html');
} catch (e) { console.error(e.message); process.exitCode = 1; }
